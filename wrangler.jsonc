{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zirbo",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "dead1fb1897146d3983a4f6f63ec47b3",
      "secret_name": "resend_api_key"
    }
  ]
}
